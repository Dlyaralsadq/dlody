# انسخ هذا الملف إلى .env.local داخل apps/clinic-system
# لا ترفع القيم الحقيقية إلى Git

# مطلوب في الإنتاج: 32 حرفاً على الأقل. يوقّع كوكي الجلسة حتى لا يمكن تزويرها.
# أنشئه بأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# اتركه فارغاً على جهازك ليبقى SQLite. في السحابة ضع رابط Neon.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# بريد رموز التحقق. المرسل يجب أن يكون على نطاق أثبتّ ملكيته في Resend.
RESEND_API_KEY=
RESET_EMAIL_FROM=Tabibee <noreply@tabibee.com>

# محلياً اتركه http://localhost:3000. بعد ربط النطاق استخدم https://tabibee.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# اختياري: تأكيد الهاتف عبر واتساب
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
