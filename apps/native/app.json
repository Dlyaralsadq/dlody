{
  "expo": {
    "name": "طبيبي",
    "slug": "tabibee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tabibee",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060912",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060912"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tabibee.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يستخدم التطبيق موقعك لعرض أقرب الأطباء إليك",
        "NSLocationAlwaysUsageDescription": "يستخدم التطبيق موقعك لعرض أقرب الأطباء إليك",
        "NSCameraUsageDescription": "لإضافة صورة شخصية أو رفع مستند",
        "NSPhotoLibraryUsageDescription": "لاختيار صورة من معرض الصور"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#060912"
      },
      "package": "com.tabibee.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060912",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a0cda03f-2137-4058-a9db-2d3b1aba9d3d"
      }
    },
    "owner": "dlyar"
  }
}
