# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/
apps/*/.next/

# private patient files (never public)
apps/clinic-system/data/patient-files/

# database
packages/database/prisma/*.db
packages/database/prisma/*.db-journal
*.db
*.db-journal

# production
/build

# misc
.DS_Store
*.pem
/tools/cloudflared
/tools/cloudflared.exe

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

*.tsbuildinfo
next-env.d.ts
apps/*/next-env.d.ts
.env.local
README.md.bak
.neon
